      "settings": {
        "foreground": "#E0645C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E0645C",
        "fontStyle": ""
      }
