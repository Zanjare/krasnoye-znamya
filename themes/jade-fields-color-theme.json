  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#80928A",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#869080",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A6C070",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E3614B",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#E58D4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E58D4F",
        "fontStyle": ""
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#E39AA2",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants (True False None null)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#E39AA2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#E3614B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage (def class const let)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E3614B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#AEB29A",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#869080",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#E8BE56",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#E8BE56",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#F2D283",
        "fontStyle": ""
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#6DAABF",
        "fontStyle": ""
      }
    },
    {
      "name": "Class definitions",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#6DAABF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#6DAABF",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DCD8C0",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E4D3A6",
        "fontStyle": ""
      }
    },
    {
      "name": "this and self",
