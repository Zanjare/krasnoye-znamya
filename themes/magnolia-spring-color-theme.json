  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6A575C",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6A575C",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#42702D",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#B02A44",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#A24A1A",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A24A1A",
        "fontStyle": ""
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#A04668",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants (True False None null)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#A04668",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#B02A44",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage (def class const let)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B02A44",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#58474B",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#6A575C",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#7A5600",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#7A5600",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#6C4B00",
        "fontStyle": ""
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#2A5E94",
        "fontStyle": ""
      }
    },
    {
      "name": "Class definitions",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#2A5E94",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#2A5E94",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#33262A",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#664818",
        "fontStyle": ""
      }
    },
    {
      "name": "this and self",
