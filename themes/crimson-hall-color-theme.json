        "support.function.magic.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#EFA6A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
