  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#85908F",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#858C8A",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A5C08A",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E0604E",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#E88F52",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#E88F52",
        "fontStyle": ""
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants (True False None null)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#E0604E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage (def class const let)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E0604E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#AEB0A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#858C8A",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#EFB555",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#EFB555",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#F6CE7E",
        "fontStyle": ""
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#7DAAC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Class definitions",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#7DAAC4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#7DAAC4",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#DAD6CA",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E6D2A6",
        "fontStyle": ""
      }
    },
    {
      "name": "this and self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": ""
      }
    },
    {
      "name": "Magic methods",
      "scope": [
        "support.function.magic.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#C4C9C2",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#86BDAE",
        "fontStyle": ""
      }
    },
    {
      "name": "Macros and preprocessor",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.other.preprocessor"
      ],
      "settings": {
        "foreground": "#DD9A9C",
        "fontStyle": ""
      }
    },
    {
      "name": "Rust lifetimes",
      "scope": [
        "entity.name.lifetime.rust",
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E88F52",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#C4C9C2",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#E0604E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#E0604E",
        "fontStyle": ""
