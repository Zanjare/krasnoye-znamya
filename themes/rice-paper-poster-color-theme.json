  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#655846",
        "fontStyle": ""
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "comment.block.documentation keyword",
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#625544",
        "fontStyle": ""
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4F6A2A",
        "fontStyle": ""
      }
    },
    {
      "name": "Template expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#AE2A1E",
        "fontStyle": ""
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#A04A14",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#A04A14",
        "fontStyle": ""
      }
    },
    {
      "name": "Other constants",
      "scope": [
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants (True False None null)",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#AE2A1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage (def class const let)",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#AE2A1E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4F443A",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#625544",
        "fontStyle": ""
      }
    },
    {
      "name": "Function definitions",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#855800",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function.any-method"
      ],
      "settings": {
        "foreground": "#855800",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in functions",
      "scope": [
        "support.function",
        "support.function.builtin",
        "support.function.builtin.python",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#774E00",
        "fontStyle": ""
      }
    },
    {
      "name": "Type references",
      "scope": [
        "entity.name.type",
        "entity.other.inherited-class",
        "support.class"
      ],
      "settings": {
        "foreground": "#1F5F78",
        "fontStyle": ""
      }
    },
    {
      "name": "Class definitions",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#1F5F78",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in types",
      "scope": [
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.primitive",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#1F5F78",
        "fontStyle": ""
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#2A2420",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#6A4A14",
        "fontStyle": ""
      }
    },
    {
      "name": "this and self",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": ""
      }
    },
    {
      "name": "Magic methods",
      "scope": [
        "support.function.magic.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": ""
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#4F4030",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#2A6B58",
        "fontStyle": ""
      }
    },
    {
      "name": "Macros and preprocessor",
      "scope": [
        "entity.name.function.macro",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive",
        "keyword.other.preprocessor"
      ],
      "settings": {
        "foreground": "#984058",
        "fontStyle": ""
      }
    },
    {
      "name": "Rust lifetimes",
      "scope": [
        "entity.name.lifetime.rust",
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#A04A14",
        "fontStyle": ""
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "#4F4030",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.create.II.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#AE2A1E",
        "fontStyle": "bold"
      }
