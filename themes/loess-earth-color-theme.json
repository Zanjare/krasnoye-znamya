      ],
      "settings": {
        "foreground": "#E2D3B5",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E8CD9A",
        "fontStyle": ""
      }
    },
    {
